monalisa {
  prakritiWait lisaaTask longTask(name, token) {
    prakritiPause prakritiConcurrency.after(20, priyoEmpty)
    token.throwIfCancelled()
    priyoGiveBack name + " finished"
  }

  priyoKeep group = prakritiConcurrency.group("cancel-demo")
  priyoKeep token = group.token()
  priyoKeep task = group.run(longTask, "mona", token)

  group.cancel("Stopped before completion")

  prakritiTry {
    priyoTell(prakritiPause task.join())
  } prakritiCatch (err) {
    priyoTell(err.code)
    priyoTell(err.message)
  }
}
