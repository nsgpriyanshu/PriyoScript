monalisa {
  prakritiWait lisaaTask fetchScore(name) {
    prakritiPause prakritiConcurrency.after(10, priyoEmpty)
    priyoGiveBack name + " ready"
  }

  priyoKeep group = prakritiConcurrency.group("scores")
  priyoKeep first = group.run(fetchScore, "mona")
  priyoKeep second = group.run(fetchScore, "lisaa")

  priyoTell(prakritiPause first.join())
  priyoTell(prakritiPause second.join())
  priyoTell(priyoArray.length(prakritiPause group.all()))
}
